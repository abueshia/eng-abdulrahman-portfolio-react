    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
