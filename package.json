    "format:check": "prettier --check .",
    "data:todo": "node scripts/real-data-report.js"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
