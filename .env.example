# Copy to `.env.local` and adjust. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so nothing secret should ever be placed here.

# Base URL of the Laravel REST API (versioned prefix included, no trailing slash).
# Default: the production API. Local backend: http://localhost:8003/api/v1
# (a build made against localhost fails verify-dist on purpose: never deploy it).
VITE_API_URL=https://eng-abdelrahman.dr-krok.com/api/v1

# Resources fetched from the live API (comma list). Unset = all five; empty = none.
# Every other resource (settings, services, stats, about, skills…) is static/mock
# data in the same build. The build FAILS if a listed resource cannot be fetched.
VITE_API_RESOURCES=projects,experiences,testimonials,faqs,contact

# Only when "contact" / "testimonials" are NOT live resources: production builds
# open WhatsApp (or the mail app) pre-filled instead of a form that reaches no one.
# VITE_CONTACT_RELAY=true
# VITE_REVIEW_RELAY=true

# Simulated network latency for the mock adapter (static resources), in milliseconds.
VITE_MOCK_LATENCY=350

# Public canonical origin: canonical URLs, hreflang, Open Graph, JSON-LD, sitemap.xml.
# Always the PRODUCTION origin (no trailing slash), even for local builds.
# It must be the domain verified in Google Search Console. Change it here and in
# Vercel if the domain ever changes, then rebuild (see SEO.md §10).
VITE_SITE_URL=https://eng-abdulrahman-abu-eisha.vercel.app

# Client-only visual effects (boot intro, service mesh, WebGL field, GSAP scenes,
# custom cursor). Content and layout never depend on them; "off" is used by the
# test suite and is handy when profiling.
VITE_FX=on

# Prerendering reads content through the same services at build time: the live
# resources come from VITE_API_URL. The backend rebuilds the site through a
# Vercel Deploy Hook (configured on the server, never here).

